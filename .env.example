# Costbook — Supabase.
#
# Copy to .env.local and fill in from your project's Settings → API.
# .env.local is gitignored; this file is the template and holds no secrets.
#
# Restart the dev server after editing — env is read at boot, not per request.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. Safe in the browser by design — RLS is what
# protects the data, which is why the policies were written first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not used by the application, and deliberately not read anywhere in it.
# The service_role key bypasses RLS entirely; if a migration needs it, the
# Supabase CLI is given it directly rather than the app holding it.

# ── Mail ─────────────────────────────────────────────────────────────────
# Until these are set, nothing is posted: a support reply is delivered inside
# Costbook and its copy waits in mail_outbox. Set them, restart, and press
# "Send waiting" on /admin/mail — the backlog goes out oldest first, each
# carrying the date it was written rather than the date it was finally sent.
RESEND_API_KEY=
MAIL_FROM=Costbook <hello@costbook.in>
